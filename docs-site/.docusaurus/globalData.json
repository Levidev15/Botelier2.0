              "parameters": [
                {
                  "name": "assistant_id",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "Assistant detail"
                }
              }
            },
            "put": {
              "summary": "Update Assistant",
              "operationId": "update_assistant",
              "tags": [
                "Assistants"
              ],
              "security": [
                {
                  "bearerAuth": []
