        "info": {
          "title": "Botelier API",
          "version": "1.0.0",
          "description": "The Botelier REST API powers all dashboard, assistant, flow, and analytics operations. Rendered via the live backend spec — this placeholder is used when the backend is not reachable at build time.\n\n**To render the live spec**, set `DOCS_API_BASE_URL` to your backend URL and rebuild the docs site.",
          "contact": {
            "name": "Botelier Platform",
            "url": "https://botelier.com"
          }
        },
        "servers": [
          {
            "url": "http://localhost:8000",
            "description": "Local development backend"
          }
        ],
        "paths": {
          "/api/assistants": {
            "get": {
              "summary": "List Assistants",
              "operationId": "list_assistants",
              "tags": [
                "Assistants"
              ],
              "description": "Returns all assistants for the authenticated account.",
              "security": [
                {
                  "bearerAuth": []
                }
              ],
              "responses": {
                "200": {
                  "description": "List of assistants",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/AssistantSummary"
                        }
                      }
                    }
                  }
                }
              }
            },
            "post": {
              "summary": "Create Assistant",
              "operationId": "create_assistant",
              "tags": [
                "Assistants"
              ],
              "description": "Creates a new assistant for the authenticated account.",
              "security": [
                {
                  "bearerAuth": []
                }
              ],
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/AssistantCreate"
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Created assistant"
                }
              }
            }
          },
